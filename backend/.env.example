PORT=5000
NODE_ENV=development

# TMDB "API Read Access Token" (v4 auth, long JWT-like string). Server-side only.
TMDB_API_KEY=

# MongoDB Atlas connection string
MONGODB_URI=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Long random string used to sign the anonymous-user cookie
COOKIE_SECRET=change-me-to-a-long-random-string

# Optional: Redis for shared cache / rate limits (falls back to in-memory if empty)
REDIS_URL=
